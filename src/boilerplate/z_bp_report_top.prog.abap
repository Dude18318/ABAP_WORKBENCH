*&---------------------------------------------------------------------*
*&  Include           Z_BP_REPORT_TOP
*&---------------------------------------------------------------------*
*& Глобальные типы, константы и ссылки.
*& Все доменно-специфичные типы определяются здесь.
*&---------------------------------------------------------------------*

TYPE-POOLS: icon.

*----------------------------------------------------------------------*
* Типы Range для параметров экрана выбора
*----------------------------------------------------------------------*
TYPES:
  ty_r_key1 TYPE RANGE OF char10,
  ty_r_key2 TYPE RANGE OF char10.

*----------------------------------------------------------------------*
* Структура параметров экрана выбора
* Используется для маппинга SELECT-OPTIONS в единый объект состояния
*----------------------------------------------------------------------*
TYPES:
  BEGIN OF ty_s_screen_params,
    key1 TYPE ty_r_key1,
    key2 TYPE ty_r_key2,
  END OF ty_s_screen_params.

*----------------------------------------------------------------------*
* Базовая ALV-структура (общие UI-поля, добавляемые ко всем строкам)
* status       — иконка-светофор (icon_green_light / icon_red_light)
* mark_del     — флаг пометки на удаление
* cell_color   — раскраска ячеек (LVC_T_SCOL)
* style        — стили ячеек (LVC_T_STYL), управление редактируемостью
* edit_indicator — иконка-индикатор изменения строки
*----------------------------------------------------------------------*
TYPES:
  BEGIN OF ty_s_alv_base,
    status         TYPE icon_d,
    mark_del       TYPE xfeld,
    cell_color     TYPE lvc_t_scol,
    style          TYPE lvc_t_styl,
    edit_indicator TYPE icon_d,
  END OF ty_s_alv_base.

*----------------------------------------------------------------------*
* ALV-структура для отображения данных
* Расширяет базовую структуру полями предметной области
*----------------------------------------------------------------------*
TYPES:
  BEGIN OF ty_s_alv_data.
    INCLUDE TYPE ty_s_alv_base.
TYPES:
    field1 TYPE char20,
    field2 TYPE char40,
    amount TYPE p LENGTH 8 DECIMALS 2,
  END OF ty_s_alv_data,
  ty_t_alv_data TYPE STANDARD TABLE OF ty_s_alv_data WITH EMPTY KEY.

*----------------------------------------------------------------------*
* DEFERRED-объявления для кросс-ссылок (FRIENDS для тестов)
*----------------------------------------------------------------------*
CLASS lcl_app DEFINITION DEFERRED.

*----------------------------------------------------------------------*
* Глобальные данные (минимальный набор для взаимодействия с Dynpro)
*----------------------------------------------------------------------*
DATA:
  go_app       TYPE REF TO lcl_app,     " Singleton-ссылка на контроллер
  gr_disp_data TYPE REF TO data.        " Динамическая ссылка на ALV-данные
